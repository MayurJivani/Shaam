---
import "../styles/global.css"
interface Props {
  title?: string
  /** "tv" for landscape big screens, "phone" for portrait controllers. */
  screen?: "tv" | "phone" | "page"
}
const { title = "Shaam", screen = "page" } = Astro.props
const world = "street" // Shaam's sticker wall; data-world stays so a game can bring its own look later
const fonts = "family=Anton&family=Archivo:wght@400..800&family=Permanent+Marker&family=Rubik+Spray+Paint"
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#0c0c0d" />
    <meta name="description" content="Party games for one TV and a room full of phones." />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={`https://fonts.googleapis.com/css2?${fonts}&display=swap`} rel="stylesheet" />
  </head>
  <body data-screen={screen} data-world={world}>
    <div class="sky" aria-hidden="true"><i></i><i></i><i></i></div>
    <slot />
  </body>
</html>
