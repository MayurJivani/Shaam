---
import "../styles/global.css"
interface Props {
  title?: string
  /** "tv" for landscape big screens, "phone" for portrait controllers. */
  screen?: "tv" | "phone" | "page"
  /** "street" is Shaam's own sticker wall; each built-in game names its own world. */
  world?: "street" | "dream"
}
const { title = "Shaam", screen = "page", world = "street" } = Astro.props
const fonts = {
  street: "family=Anton&family=Archivo:wght@400..800&family=Permanent+Marker&family=Rubik+Spray+Paint",
  dream: "family=Fraunces:ital,opsz,wght,SOFT,WONK@0,9..144,400..800,100,1;1,9..144,400..700,100,1&family=Bricolage+Grotesque:opsz,wght@12..96,400..800",
}[world]
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content={world === "dream" ? "#c9cdee" : "#0c0c0d"} />
    <meta name="description" content="Party games for one TV and a room full of phones." />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={`https://fonts.googleapis.com/css2?${fonts}&display=swap`} rel="stylesheet" />
  </head>
  <body data-screen={screen} data-world={world}>
    <div class="sky" aria-hidden="true"><i></i><i></i><i></i></div>
    <slot />
  </body>
</html>
