---
import Layout from "../layouts/Layout.astro"
import { GAMES } from "../../shared/games.js"
---

<Layout title="Shaam · party games">
  <main class="landing">
    <h1 class="brand">Shaam</h1>
    <p class="tagline">Every game in one place. Tap one to start it on this screen, or start a party to keep one leaderboard across the night.</p>
    <ul class="shelf">
      {GAMES.map((g) => (
        <li>
          <a class="shelf-card" href={g.builtIn ? `/${g.slug}` : g.url} {...(g.url?.startsWith("http") ? { target: "_blank", rel: "noopener" } : {})}>
            <span class="shelf-name">{g.name}</span>
            <span class="shelf-blurb">{g.blurb}</span>
            <span class="shelf-meta">{g.players} players · {g.url?.startsWith("http") ? "opens its own site" : "plays here"}</span>
          </a>
        </li>
      ))}
    </ul>
    <div class="row">
      <a class="btn primary big" href="/tv">Start a party on this screen</a>
      <a class="btn big" href="/join">Join with a code</a>
    </div>
  </main>
</Layout>
